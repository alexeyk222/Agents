# Шаблон переменных окружения для OAC.
# Скопируйте в .env (он не должен попадать в Git) и заполните реальными значениями.
# Подробности подключения: .opencode/context/enterprise/setup/mcp-connection.md

# --- Confluence / Jira (MCP-сервер `atlassian`, Server / Data Center) ---
CONFLUENCE_URL=https://confluence.example.corp
CONFLUENCE_PERSONAL_TOKEN=your_confluence_pat
CONFLUENCE_SPACES_FILTER=DWH,DATA
JIRA_URL=https://jira.example.corp
JIRA_PERSONAL_TOKEN=your_jira_pat
JIRA_PROJECTS_FILTER=DATA
# Внутренний корпоративный CA (при необходимости)
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/corp-ca.pem

# --- Impala (MCP-сервер `impala`, impala-shell или impyla в ноутбуке) ---
IMPALA_HOST=impala.example.corp
IMPALA_PORT=21050
# GSSAPI (Kerberos, билет через kinit) или LDAP
IMPALA_AUTH_MECHANISM=GSSAPI
IMPALA_USE_SSL=true
# Только для LDAP:
# IMPALA_USER=
# IMPALA_PASSWORD=

# --- JupyterHub (skill jupyter-notebook) ---
JUPYTERHUB_URL=https://jupyterhub.example.corp
JUPYTERHUB_API_TOKEN=your_jupyterhub_token

# --- Внутреннее PyPI-зеркало для установки зависимостей в закрытом контуре ---
# PIP_INDEX_URL=https://nexus.example.corp/repository/pypi/simple

# --- Генерация изображений (skills generate-image, scientific-slides) ---
# Внешний сервис: в закрытом контуре обычно недоступен.
# OPENROUTER_API_KEY=
